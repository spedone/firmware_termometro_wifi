@startuml
title Diagramma di Stato - Task Network

[*] --> wifi_start : Avvio Task

state wifi_start {
  wifi_start : Controllo SSID in configurazione
}

wifi_start --> ap_mode_start : SSID vuoto
wifi_start --> wifi_wait : SSID presente / WiFi.begin()[cite: 1]

state wifi_wait {
  wifi_wait : Attesa connessione (max 10s)
}

wifi_wait --> wifi_idle : Connesso (WL_CONNECTED)[cite: 1]
wifi_wait --> ap_mode_start : Timeout > 10 secondi[cite: 1]

state wifi_idle {
  wifi_idle : Sistema operativo in rete
}

wifi_idle --> wifi_start : Connessione persa o resetNetwork[cite: 1]

state ap_mode_start {
  ap_mode_start : Configurazione Soft-AP
}

ap_mode_start --> ap_mode_idle : AP Attivo[cite: 1]

state ap_mode_idle {
  ap_mode_idle : Attesa segnale di reset
}

ap_mode_idle --> wifi_start : resetNetwork ricevuto[cite: 1]

@enduml
@startuml TaskBatteria_State
title FMW_TWIFI_ARDESP32 v. 1.2 - Task Batteria


[*] --> battery_idle

state battery_idle{
  battery_idle: lettura tensione
  battery_idle: calcolo percentuale
  battery_idle: aggiorna variab.condivisa
}

state battery_read{
  
}

state deep_sleep_mode{
  deep_sleep_mode: segnale deepSleep = true 
  deep_sleep_mode: attesa 5 secondi
  deep_sleep_mode: avvia deep sleep mode

}


battery_idle --> battery_idle : Attesa 15 sec
battery_idle --> battery_read : timeout 15 sec 
battery_idle --> battery_read : prima lettura

battery_read --> battery_idle : tensione > 3.39 V
battery_read --> deep_sleep_mode : tensione <= 3.39 V

@enduml